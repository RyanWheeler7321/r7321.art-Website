<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }} | Ryan Wheeler</title>
  <meta name="description" content="{{ description }}">
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" href="/favicon.ico">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&family=JetBrains+Mono:wght@500&display=swap"
    rel="stylesheet"
  >
  <link rel="stylesheet" href="/assets/css/portfolio.css?v={{ site.assetVersion }}">
  <noscript><style>.group { visibility: visible !important; } .tile img[data-src] { display: none; }</style></noscript>
  {% if home %}<link rel="stylesheet" href="/assets/css/portfolio-home.css?v={{ site.assetVersion }}">{% endif %}
</head>
<body{% if home %} class="home"{% endif %}>
  <div class="backdrop" aria-hidden="true"><i></i><b class="glow"></b></div>

  {% if home %}<h1 class="me">Ryan Wheeler</h1>{% endif %}
  <header class="top-bar">
    {% if not home %}<a class="name" href="/portfolio/">Ryan Wheeler</a>{% endif %}
    <nav class="sections">
      <i class="light"></i>
      {% for s in portfolio.sections %}
        {% if s.url %}
          <a href="{{ s.url }}" class="{% if s.name == section %}on{% endif %}" aria-label="{{ s.name }}">
            <svg viewBox="0 0 16 16" aria-hidden="true">{{ s.icon | safe }}</svg><span>{{ s.name }}</span>
          </a>
        {% else %}
          <span class="soon"><svg viewBox="0 0 16 16" aria-hidden="true">{{ s.icon | safe }}</svg><span>{{ s.name }}</span></span>
        {% endif %}
      {% endfor %}
    </nav>
    <a class="resume" href="{{ portfolio.resume }}" download>Resume</a>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <script src="/assets/js/portfolio.js?v={{ site.assetVersion }}" onerror="document.querySelectorAll('img[data-src]').forEach((i) => { i.srcset = i.dataset.srcset; i.src = i.dataset.src; }); document.body.classList.add('laid')"></script>
  {% if home %}<script src="/assets/js/portfolio-home.js?v={{ site.assetVersion }}"></script>{% endif %}
</body>
</html>

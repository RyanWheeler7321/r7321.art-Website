---
layout: layouts/base.njk
pageClass: page-home
title: Home
description: Ryan Wheeler's games, art, projects, updates, and tools.
---
{% set featuredProject = collections.projects | featuredProject %}
{% set recentUpdates = collections.updates %}
{% set projectItems = collections.projects %}
{% set homeToolOrder = [
  "maze-tools",
  "3d-viewer",
  "unity-tools",
  "board-studio",
  "paint-studio",
  "r7321-art-website",
  "r7harness",
  "spotify-randomizer",
  "youtube-position-saver",
  "chrome-bookmark-tool"
] %}
{% set homeTools = collections.tools | orderBySlugs(homeToolOrder) %}

<section class="home-layout home-layout-wide">
  <aside class="home-side-rail" data-home-fit-rail>
    <div class="home-column-panel home-updates-panel" data-home-fit-panel>
      <div class="home-section-heading">
        <h2>Updates</h2>
      </div>

      <div class="home-stack-list">
        {% for update in recentUpdates %}
          <a class="update-button home-list-card" href="{{ update.url }}" data-home-fit-item>
            {% media update.data.thumbnail, update.data.title, "home-list-thumbnail", "auto", "76px" %}
            <div class="update-button-copy">
              <h3>{{ update.data.title }}</h3>
              <p class="list-card-date">{{ update.date | teaserDate }}</p>
            </div>
          </a>
        {% endfor %}
      </div>
      <a class="home-list-card home-list-more" href="/updates/" aria-label="View all updates" data-home-fit-more>...</a>
    </div>
  </aside>

  <div class="home-main-column" data-home-center>
    <section class="home-splash">
      <a class="home-splash-link" href="{{ featuredProject.url }}">
        {% media featuredProject.data.heroImage or featuredProject.data.thumbnail, featuredProject.data.title, "home-splash-image", "high", "(max-width: 1080px) 100vw, 1200px" %}
      </a>
    </section>

    <section class="home-feature">
      <div class="home-feature-top">
        <h1>{{ featuredProject.data.title }}</h1>
        {% if featuredProject.data.externalLinks and featuredProject.data.externalLinks[0] %}
          <a class="feature-link home-play-link" href="{{ featuredProject.data.externalLinks[0].url }}" target="_blank" rel="noopener">
            PLAY NOW
          </a>
        {% endif %}
      </div>
      <p>{{ featuredProject.data.summary }}</p>
    </section>

    <section class="home-projects">
      <div class="home-section-heading">
        <h2>Projects</h2>
      </div>

      <div class="home-project-grid">
        {% for project in projectItems %}
          <a class="project-button home-project-card" href="{{ project.url }}">
            {% media project.data.thumbnail, project.data.title, "home-project-image", "auto", "(max-width: 1080px) 33vw, 420px" %}
            <div class="project-button-copy">
              <div class="home-project-head">
                <h3>{{ project.data.title }}</h3>
                <p class="home-project-date">{{ project.data.dateLabel }}</p>
              </div>
            </div>
          </a>
        {% endfor %}
      </div>
    </section>
  </div>

  <aside class="home-side-rail home-tools-rail" data-home-fit-rail>
    <div class="home-column-panel home-tools-panel" data-home-fit-panel>
      <div class="home-section-heading">
        <h2>Tools</h2>
      </div>

      {% if homeTools.length %}
        <div class="home-stack-list">
          {% for tool in homeTools %}
            <a class="tool-card home-list-card" href="{{ tool.url }}" data-home-fit-item>
              {% if tool.data.thumbnail %}
                <img src="{{ tool.data.thumbnail | optimizedImage }}" alt="{{ tool.data.title }}">
              {% else %}
                <span class="tool-icon-fallback tool-icon-fallback-small" aria-hidden="true">
                  <i class="{{ tool.data.icon or 'fas fa-circle' }}"></i>
                </span>
              {% endif %}
              <div>
                <h3>{{ tool.data.title }}</h3>
              </div>
            </a>
          {% endfor %}
          <a class="home-list-card home-list-more" href="/tools/" aria-label="View all tools" data-home-fit-more>...</a>
        </div>
      {% else %}
        <div class="empty-state-card">
          <h3>No public tools yet.</h3>
        </div>
      {% endif %}
    </div>
  </aside>
</section>
